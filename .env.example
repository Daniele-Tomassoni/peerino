# ==============================================================
# PEERINO — Configuration Template
# ==============================================================
# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` with real values (see .gitignore).
# ==============================================================

# ===== TURN: Metered (temporary, for free tier) =====
# Sign up at https://metered.ca to get your API key.
# Leave empty to disable Metered and use Coturn or STUN only.
METERED_API_KEY=your_metered_api_key_here
METERED_API_BASE=peerino.metered.live

# ===== TURN: Credentials (frontend, build-time) =====
# These are used by the PeerJS engine in the desktop app.
# Get them from the Metered dashboard (TURN credentials).
VITE_TURN_USERNAME=your_turn_username_here
VITE_TURN_PASSWORD=your_turn_password_here

# ===== TURN: Coturn self-hosted (fallback) =====
# TURN_AUTH_SECRET: generate with `openssl rand -hex 32` after
# configuring Coturn on the VPS. It must match `static-auth-secret`
# in the VPS turnserver.conf.
TURN_URLS=turn:your-domain.com:3478
TURN_AUTH_SECRET=your_static_auth_secret_here
TURN_CRED_TTL_SECS=7200

# ===== STUN (public servers, no secrets) =====
STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.rtc.yandex.net:3478,stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478,stun:stun1.l.google.com:19302

# ===== SIGNALING =====
# SIGNALING_URL: self-hosted PeerJS signaling server host.
# Omit or leave empty to use the default cloud (0.peerjs.com).
# Already supported by the Rust backend (ice_provider.rs, turn_creds.rs).
SIGNALING_URL=your-signaling-server.com

# ===== APP =====
P2P_WEB_URL=https://your-domain.com/receiver
P2P_SHARE_URL=
HTTP_PORT=3000

# ===== TURN: File size limit (temporary) =====
# Files larger than this value are BLOCKED when the connection
# uses TURN (relay). On LAN and STUN, there is no limit.
#
# Current value: 1024 bytes (1 KB) — TEMPORARY.
# Reason: using Metered free tier (500 MB/month) as an "alert-only"
# channel. Any file > 1 KB is blocked on TURN, and the user is
# asked to switch to WiFi. This saves bandwidth.
#
# TODO: increase to 104857600 (100 MB) once Coturn VPS is ready.
TURN_MAX_FILE_SIZE=1024

# ===== ICE Provider selection =====
# Valori validi: metered | coturn | static | (vuoto = auto)
# Se non impostato, il comportamento è legacy (Metered → Coturn → Static).
# ICE_PROVIDER=metered
