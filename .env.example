# ==============================================================
# PEERINO — Configuration Template
# ==============================================================
# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` with real values (see .gitignore).
# ==============================================================

# ===== TURN: Cloudflare Worker (recommended) =====
# 1. Deploy the Worker in peerino-turn-proxy/ (see that folder's README)
# 2. Set the endpoint URL below
TURN_CREDENTIALS_ENDPOINT=https://your-worker.workers.dev/api/turn-credentials

# ===== TURN: Metered (legacy, still available) =====
# Sign up at https://metered.ca to get your API key.
# Leave empty to disable Metered and use Cloudflare or STUN only.
# METERED_API_KEY=your_metered_api_key_here
# METERED_API_BASE=peerino.metered.live

# ===== TURN: frontend credentials (removed in v1.0.11) =====
# The desktop PeerJS engine uses static STUN only. Receivers get
# dynamic Cloudflare TURN credentials via the `ice=` link parameter.
# VITE_TURN_USERNAME / VITE_TURN_PASSWORD no longer needed.

# ===== TURN: Coturn self-hosted (fallback, inactive) =====
# Uncomment when coturn is deployed on a VPS:
# TURN_URLS=turn:your-domain.com:3478
# TURN_AUTH_SECRET=your_static_auth_secret_here
# TURN_CRED_TTL_SECS=7200

# ===== STUN (public servers, no secrets) =====
STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.rtc.yandex.net:3478,stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478,stun:stun1.l.google.com:19302

# ===== SIGNALING =====
# SIGNALING_URL: self-hosted PeerJS signaling server host.
# Omit or leave empty to use the default cloud (0.peerjs.com).
# Already supported by the Rust backend (ice_provider.rs, turn_creds.rs).
SIGNALING_URL=your-signaling-server.com

# ===== APP =====
P2P_WEB_URL=https://your-domain.com/receiver
P2P_SHARE_URL=
HTTP_PORT=3000

# ===== TURN: File size limit =====
# Default: 0. TURN is diagnostic-only.
# No file passes through relay, regardless of size.
# TURN is used only to signal that a direct connection is
# impossible; the user is asked to try a different network.
# TURN_MAX_FILE_SIZE=0

# ===== ICE Provider selection =====
# Valori validi: cloudflare | metered | coturn | static | (vuoto = auto)
# Se non impostato, il comportamento è auto (Metered → Cloudflare → Coturn → Static).
ICE_PROVIDER=cloudflare
